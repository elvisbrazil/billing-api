{
  "name": "billing-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "fastify-type-provider-zod": "6.1.0",
    "pg": "8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.4",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "globals": "17.4.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1",
    "vitest": "4.1.6"
  }
}
